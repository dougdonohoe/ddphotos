#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="ddphotos"

cmd="${1:-help}"
shift 2>/dev/null || true

# Read DDPHOTOS_SITE_ID from env, then config/defaults.env, then fall back to default
if [ -z "$DDPHOTOS_SITE_ID" ]; then
    DEFAULTS_ENV="$SCRIPT_DIR/config/defaults.env"
    if [ -f "$DEFAULTS_ENV" ]; then
        DDPHOTOS_SITE_ID=$(sed -n 's/^DDPHOTOS_SITE_ID=//p' "$DEFAULTS_ENV")
    fi
fi
DDPHOTOS_SITE_ID="${DDPHOTOS_SITE_ID:-my-photos}"

# Parse bases: section from albums.yaml and emit -v flags for external photo dirs.
# Paths already inside SCRIPT_DIR are skipped (covered by the main /ddphotos mount).
# Populates MOUNT_ARGS (for docker run), MOUNT_PATHS and MOUNT_DESTS (for display).
build_mount_args() {
    local config="$SCRIPT_DIR/config/albums.yaml"
    [ -f "$config" ] || return
    local in_bases=false
    while IFS= read -r line; do
        if [[ "$line" =~ ^bases: ]]; then
            in_bases=true
            continue
        fi
        if $in_bases; then
            [[ "$line" =~ ^[a-zA-Z_] ]] && break
            [[ "$line" =~ ^[[:space:]]*# ]] && continue
            local path
            path=$(echo "$line" | sed 's/^[[:space:]]*[^:]*:[[:space:]]*//')
            path="${path/#\~/$HOME}"
            if [[ "$path" == /* ]] && [[ "$path" != "$SCRIPT_DIR"* ]]; then
                MOUNT_ARGS+=(-v "$path:$path:ro")
                MOUNT_PATHS+=("$path")
                MOUNT_DESTS+=("$path")
            fi
        fi
    done < "$config"
}

# Print all Docker volume mounts for the current command.
print_mounts() {
    echo "Mounting:"
    echo "  $SCRIPT_DIR -> /ddphotos"
    local i=0
    while [ $i -lt ${#MOUNT_PATHS[@]} ]; do
        echo "  ${MOUNT_PATHS[$i]} -> ${MOUNT_DESTS[$i]} (read-only)"
        i=$((i + 1))
    done
    echo ""
}

# Check that the local ddphotos script matches the copy baked into the image.
# Uses docker create/cp/rm to extract the file without starting a container.
# Skipped for init/upgrade/help since those don't depend on script/image compatibility.
check_version() {
    local tmp cid
    tmp=$(mktemp)
    cid=$(docker create "$IMAGE" 2>/dev/null) || { rm -f "$tmp"; return; }
    docker cp "$cid":/docker/ddphotos "$tmp" 2>/dev/null || true
    docker rm "$cid" > /dev/null 2>&1 || true
    if ! diff -q "$SCRIPT_DIR/ddphotos" "$tmp" > /dev/null 2>&1; then
        rm -f "$tmp"
        echo "Error: local ddphotos script does not match the image."
        echo "Run: ./ddphotos upgrade"
        exit 1
    fi
    rm -f "$tmp"
}

SERVE_PORT="${SERVE_PORT:-8000}"
RUN_PORT="${RUN_PORT:-5173}"

case "$cmd" in
    init)
        docker run --rm \
            -v "$SCRIPT_DIR":/ddphotos \
            "$IMAGE" init "$@"
        ;;
    photogen)
        check_version
        MOUNT_ARGS=()
        MOUNT_PATHS=()
        MOUNT_DESTS=()
        build_mount_args
        print_mounts
        docker run --rm \
            -e DDPHOTOS_SITE_ID="$DDPHOTOS_SITE_ID" \
            -v "$SCRIPT_DIR":/ddphotos \
            "${MOUNT_ARGS[@]}" \
            "$IMAGE" photogen "$@"
        ;;
    build)
        check_version
        MOUNT_PATHS=()
        MOUNT_DESTS=()
        print_mounts
        docker run --rm \
            -e DDPHOTOS_SITE_ID="$DDPHOTOS_SITE_ID" \
            -v "$SCRIPT_DIR":/ddphotos \
            "$IMAGE" build "$@"
        ;;
    serve)
        check_version
        MOUNT_PATHS=()
        MOUNT_DESTS=()
        print_mounts
        docker run --rm -it \
            -e DDPHOTOS_SITE_ID="$DDPHOTOS_SITE_ID" \
            -e SERVE_PORT="$SERVE_PORT" \
            -v "$SCRIPT_DIR":/ddphotos \
            -p "$SERVE_PORT":80 \
            "$IMAGE" serve "$@"
        ;;
    run)
        check_version
        MOUNT_PATHS=()
        MOUNT_DESTS=()
        print_mounts
        docker run --rm -it \
            -e DDPHOTOS_SITE_ID="$DDPHOTOS_SITE_ID" \
            -e RUN_PORT="$RUN_PORT" \
            -v "$SCRIPT_DIR":/ddphotos \
            -p "$RUN_PORT":5173 \
            "$IMAGE" run "$@"
        ;;
    deploy)
        check_version
        MOUNT_PATHS=()
        MOUNT_DESTS=()
        DEPLOY_ARGS=()
        if [ -d "$HOME/.ssh" ]; then
            DEPLOY_ARGS+=(-v "$HOME/.ssh":/root/.ssh:ro)
            MOUNT_PATHS+=("$HOME/.ssh")
            MOUNT_DESTS+=("/root/.ssh")
        fi
        if [ -d "$HOME/.aws" ]; then
            DEPLOY_ARGS+=(-v "$HOME/.aws":/root/.aws:ro)
            MOUNT_PATHS+=("$HOME/.aws")
            MOUNT_DESTS+=("/root/.aws")
        fi
        for var in AWS_PROFILE AWS_DEFAULT_PROFILE AWS_DEFAULT_REGION AWS_REGION \
                   AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN; do
            [ -n "${!var}" ] && DEPLOY_ARGS+=(-e "$var=${!var}")
        done
        print_mounts
        docker run --rm \
            -e DDPHOTOS_SITE_ID="$DDPHOTOS_SITE_ID" \
            -v "$SCRIPT_DIR":/ddphotos \
            "${DEPLOY_ARGS[@]}" \
            "$IMAGE" deploy "$@"
        ;;
    upgrade)
        docker run --rm \
            -v "$SCRIPT_DIR":/ddphotos \
            "$IMAGE" upgrade
        ;;
    *)
        echo "Usage: ./ddphotos {init|photogen|build|serve|run|deploy|upgrade} [args]"
        echo ""
        echo "Commands:"
        echo "  init      Re-initialize config scaffold"
        echo "  photogen  Process source photos into albums output"
        echo "  build     Build the static site"
        echo "  serve     Preview the site via Apache on port \$SERVE_PORT (default 8000)"
        echo "  run       Preview the site via Vite dev server on port \$RUN_PORT (default 5173)"
        echo "  deploy    Deploy build and albums to remote host"
        echo "  upgrade   Update this script to match the current image"
        echo ""
        echo "Tip: pass -- to photogen for full flag control:"
        echo "  ./ddphotos photogen -- -config-dir /custom -resize"
        exit 1
        ;;
esac
